<div class="layout">
  {% if hs_view %}
    {% render 'volcano_map', view: hs_view, site_url: site_url, version: version, show_labels: hs_labels, map_scale: 1.5 %}
  {% else %}
    <span class="title">Volcano data unavailable</span>
  {% endif %}
</div>

{% render 'volcano_title', data_as_of: data_as_of, stale: hs_stale %}
