<div class="layout">
  {% if hs_view == nil %}
    <div class="flex flex--col gap--small">
      <span class="title">The lava feed has cooled off</span>
      <span class="description">No volcano data right now. It should flow again after the next daily update.</span>
    </div>
  {% elsif hs_view.world %}
    {% render 'volcano_world', view: hs_view, markers: markers, show_labels: hs_labels, show_list: hs_list, list_side: true, list_cols: "1,2,1,3", max_labels: max_labels, map_scale: 1.5 %}
  {% else %}
    {% render 'volcano_closeup', view: hs_view, markers: markers, show_labels: hs_labels, show_list: hs_list, list_side: true, list_cols: "1,2,1,3", max_labels: max_labels, map_scale: 1.5 %}
  {% endif %}
</div>

{% if hs_title %}{% render 'volcano_title' %}{% endif %}
