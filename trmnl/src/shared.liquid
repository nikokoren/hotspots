{% comment %}
  Hotspots: shared markup for all layouts.

  Polled payload (latest.json, published daily by GitHub Actions):
    generated_at, data_as_of, version, default_view, max_labels,
    markers: [ { n, lat, lon, w, c, a } ]            ranked; used by close-up views
    views: { <key>: { label, world: true,  shift, markers: [ { n, x, y, w, c, a, l } ] }
           | { label, world: false, bbox: [west, south, east, north] } }
      w  dot diameter, % of map width      c  TRMNL background class (age)
      x, y  world position, % of the 2:1 box   l  label side r/l/t/b ("" = none)
      shift  % to slide the tiled world image so the chosen meridian is centred

  World views: a land mask (white ocean, transparent land) on a framework grey box,
  as in the TRMNL community earthquake recipe (https://usetrmnl.com/recipes/33312),
  whose world image is a placeholder here until we have our own.
  Close-up views: the TRMNL framework map (TRMNLMaps over MapLibre and TRMNL's
  OpenStreetMap tiles), repainted to the same grey land / white water, with the
  markers projected and labelled in the browser.
{% endcomment %}
<style>
  .hs-map { position: relative; width: min(100cqw, 200cqh); aspect-ratio: 2 / 1; margin: 0 auto; line-height: 0; border-radius: 8px; overflow: hidden; }
  .hs-strip { position: absolute; top: 0; height: 100%; width: 200%; display: flex; }
  .hs-strip > img { width: 50%; height: 100%; }
  .hs-v { position: absolute; aspect-ratio: 1 / 1; transform: translate(-50%, -50%); z-index: 3; }
  .hs-v > i { position: absolute; inset: 0; border-radius: 50%; }
  .hs-v > i.hs-halo { inset: -22%; }
  .hs-l { position: absolute; white-space: nowrap; line-height: 1; }
  .hs-l--r { left: 100%; top: 50%; transform: translateY(-50%); margin-left: 3px; }
  .hs-l--l { right: 100%; top: 50%; transform: translateY(-50%); margin-right: 3px; }
  .hs-l--t { bottom: 100%; left: 50%; transform: translateX(-50%); margin-bottom: 2px; }
  .hs-l--b { top: 100%; left: 50%; transform: translateX(-50%); margin-top: 2px; }
</style>
{% template volcano_icon %}
<svg width="24px" height="24px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
  <path d="M1 21 L8.5 6.5 L10.6 9 L12 6.8 L13.4 9 L15.5 6.5 L23 21 Z" stroke="white" stroke-width="3" stroke-linejoin="round"/>
  <path d="M1 21 L8.5 6.5 L10.6 9 L12 6.8 L13.4 9 L15.5 6.5 L23 21 Z"/>
</svg>
{% endtemplate %}
{% template volcano_world %}
{% assign world_mask = '' %}
<div class="hs-map bg--gray-70 4bit:bg--gray-65">
  <div class="hs-strip" style="left: -{{ view.shift }}%;">
    <img src="data:image/png;base64,{{ world_mask }}" alt="" /><img src="data:image/png;base64,{{ world_mask }}" alt="" />
  </div>
  {% for m in view.markers %}
    {% assign w = m.w | times: map_scale %}
    <div class="hs-v" style="left: {{ m.x }}%; top: {{ m.y }}%; width: {{ w }}%;">
      <i class="hs-halo bg--white"></i>
      <i class="{{ m.c }}"></i>
      {% if show_labels and m.l != "" %}<span class="hs-l hs-l--{{ m.l }} label label--small text-stroke">{{ m.n }}</span>{% endif %}
    </div>
  {% endfor %}
</div>
{% endtemplate %}
{% template volcano_closeup %}
<script src="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.js"></script>
<link href="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.css" rel="stylesheet">
<div id="hs-closeup" class="map stretch w--full rounded--base">
  <span class="map__fallback title">Map unavailable on this screen</span>
</div>
<script type="text/javascript">
  (function () {
    var el = "hs-closeup";
    var bbox = {{ view.bbox | json }};
    var markers = {{ markers | json }};
    var showLabels = {{ show_labels | json }};
    var maxLabels = {{ max_labels | json }};
    var mapScale = {{ map_scale | json }};
    var KEEP = ["background", "ocean", "water"];

    function whenReady(cb) {
      var tries = 0;
      (function attempt() {
        if (window.TRMNLMaps && window.maplibregl) return cb();
        if (++tries > 200) return;
        setTimeout(attempt, 50);
      })();
    }

    // A framework grey as MapLibre paint. Like the framework's own presets, an opaque
    // dither tile is painted as its flat key color, which the runtime's dither pass
    // swaps for the tile art once the map settles; solids stay solid.
    // Flat tiles are found through style.metadata["trmnl:tiles"], so record them there.
    function paint(style, kind, token) {
      var p = TRMNLMaps.paint(token, { el: el }), out = {};
      if (p.pattern && p.pattern.opaque && p.pattern.keyColor) {
        out[kind + "-color"] = p.pattern.keyColor;
        style.metadata = style.metadata || {};
        var ids = style.metadata["trmnl:tiles"] = style.metadata["trmnl:tiles"] || [];
        if (ids.indexOf(p.pattern.id) < 0) ids.push(p.pattern.id);
      } else if (p.pattern) out[kind + "-pattern"] = p.pattern.id;
      else out[kind + "-color"] = p.color;
      return out;
    }

    function overlaps(a, b) { return a[0] < b[2] && b[0] < a[2] && a[1] < b[3] && b[1] < a[3]; }

    // Markers are our own markup over the map: dot size and shade come from the payload.
    function place(map) {
      var box = document.getElementById(el);
      Array.prototype.forEach.call(box.querySelectorAll(".hs-v"), function (n) { n.remove(); });
      var W = box.clientWidth, H = box.clientHeight, c = map.getCenter().lng, shown = [];
      markers.forEach(function (m) {
        var lon = c + ((m.lon - c + 540) % 360) - 180;  // nearest world copy
        var pt = map.project([lon, m.lat]);
        if (pt.x < 0 || pt.x > W || pt.y < 0 || pt.y > H) return;
        var d = m.w * mapScale * W / 100;
        var v = document.createElement("div");
        v.className = "hs-v";
        v.style.left = Math.round(pt.x) + "px";
        v.style.top = Math.round(pt.y) + "px";
        v.style.width = Math.round(d) + "px";
        v.innerHTML = '<i class="hs-halo bg--white"></i><i class="' + m.c + '"></i>';
        box.appendChild(v);
        shown.push({ m: m, v: v, x: pt.x, y: pt.y, r: d / 2 });
      });
      if (!showLabels) return;
      var taken = shown.map(function (s) { return [s.x - s.r, s.y - s.r, s.x + s.r, s.y + s.r]; });
      shown.slice().sort(function (a, b) { return a.m.a - b.m.a; }).slice(0, maxLabels).forEach(function (s) {
        var span = document.createElement("span");
        span.className = "hs-l label label--small text-stroke";
        span.textContent = s.m.n;
        s.v.appendChild(span);
        var tw = span.offsetWidth, th = span.offsetHeight, g = 3;
        var options = {
          r: [s.x + s.r + g, s.y - th / 2, s.x + s.r + g + tw, s.y + th / 2],
          l: [s.x - s.r - g - tw, s.y - th / 2, s.x - s.r - g, s.y + th / 2],
          t: [s.x - tw / 2, s.y - s.r - g - th, s.x + tw / 2, s.y - s.r - g],
          b: [s.x - tw / 2, s.y + s.r + g, s.x + tw / 2, s.y + s.r + g + th]
        };
        var side = Object.keys(options).find(function (k) {
          var b = options[k];
          return b[0] >= 0 && b[1] >= 0 && b[2] <= W && b[3] <= H && !taken.some(function (t) { return overlaps(b, t); });
        });
        if (!side) { span.remove(); return; }
        taken.push(options[side]);
        span.classList.add("hs-l--" + side);
      });
    }

    whenReady(function () {
      TRMNLMaps.watch(el, function () {
        var opts = TRMNLMaps.options({
          el: el, preset: "outline", tiles: "trmnl", labels: false,
          center: [(bbox[0] + bbox[2]) / 2, (bbox[1] + bbox[3]) / 2], zoom: 3
        });
        // Coast and water only, repainted to match the world views: grey land, white sea.
        opts.style.layers = opts.style.layers.filter(function (l) { return KEEP.indexOf(l.id) >= 0; });
        opts.style.layers.forEach(function (l) {
          if (l.id === "background") l.paint = paint(opts.style, "background", "gray-70");
          else l.paint = Object.assign({ "fill-antialias": false }, paint(opts.style, "fill", "white"));
        });
        opts.renderWorldCopies = true;
        var map = new maplibregl.Map(opts);
        // Zoom stays on whole numbers so dither lands on the pixel grid. Round up when the
        // exact fit is within 0.3 of the next zoom (crops the box by at most ~20%), otherwise
        // round down (shows a little more than the box).
        var cam = map.cameraForBounds([[bbox[0], bbox[1]], [bbox[2], bbox[3]]], { padding: 0 });
        if (cam) map.jumpTo({ center: cam.center, zoom: Math.min(6, Math.floor(cam.zoom + 0.3)) });
        map.on("load", function () { place(map); });
        return map;
      });
    });
  })();
</script>
{% endtemplate %}
{% template volcano_title %}
<div class="title_bar">
  {% render 'volcano_icon' %}
  <span class="title">Hotspots</span>
  <span class="instance">{% if data_as_of %}VIIRS {{ data_as_of | date: "%b %-d, %H:%M" }} UTC{% if stale %} · stale{% endif %}{% else %}No data{% endif %}</span>
</div>
{% endtemplate %}
{% assign cfv = trmnl.plugin_settings.custom_fields_values %}
{% assign hs_region = cfv.region | default: default_view | default: "world-europe" %}
{% assign hs_view = views[hs_region] | default: views[default_view] %}
{% assign hs_labels = false %}
{% if cfv.labels == true or cfv.labels == "true" or cfv.labels == "yes" %}{% assign hs_labels = true %}{% endif %}
{% assign hs_now = "now" | date: "%s" | plus: 0 %}
{% assign hs_gen = generated_at | date: "%s" | plus: 0 %}
{% assign hs_age_h = hs_now | minus: hs_gen | divided_by: 3600 %}
{% assign hs_stale = false %}
{% if generated_at and hs_age_h > 36 %}{% assign hs_stale = true %}{% endif %}
