{% comment %}
  Hotspots: shared markup for all layouts.

  Polled payload (latest.json, published daily by GitHub Actions):
    generated_at, data_as_of, version, default_view, max_labels,
    markers: [ { n, lat, lon, w, c, a, k, co, s } ]  ranked; framework map + volcano list
    views: { <key>: { label, world: true,  shift, lon, markers: [ { n, x, y, w, c, a, k } ] }
           | { label, world: false, bbox: [west, south, east, north] } }
      w  icon width, % of map width      c  TRMNL background class (age)
      x, y  world position, % of the 2:1 box    k  icon: lava (heat) | erupt (confirmed eruption)
      Map labels are placed in the browser for every map (HSMap), at each layout's real size.
      co  country    s  latest observation, Unix seconds    a  its age at run time, h
      shift  % to slide the tiled world image so the chosen meridian (lon) is centred

  World views: on TRMNL X (screen--lg), unless the volcano list is on, the framework map
  fills the space, centred on the chosen meridian. Elsewhere our own 2:1 world map: a Natural Earth land mask (backend/scripts/build_world_map.py)
  painted with the framework's map-land / map-water slots, repeated across a 200% strip
  and slid sideways. With the volcano list setting on, our map is always used and the
  height or width it leaves holds the list, newest first (beside the map in wide spaces,
  below it otherwise).
  Close-up views: the TRMNL framework map (TRMNLMaps over MapLibre and TRMNL's
  OpenStreetMap tiles, outline preset), with the markers projected and labelled in the browser.
{% endcomment %}
<style>
  /* icon masks: generated by backend/scripts/build_icons.py */
  :root {
  --hs-lava: url(data:image/png;base64,);
  --hs-lava-halo: url(data:image/png;base64,);
  --hs-erupt: url(data:image/png;base64,);
  --hs-erupt-halo: url(data:image/png;base64,);
  }
  /* Layout, show/hide and list arrangement use framework classes in the markup. What is left
     here has no framework equivalent: list overflow inside flex, the 2:1 world map, the icon
     masks, and markers and labels placed at a point. */
  .hs-list, .hs-list .content, .hs-list .content .flex { min-width: 0; min-height: 0; overflow: hidden; }
  .hs-list .content .description { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .hs-map { flex: none; position: relative; width: min(100cqw, 200cqh); aspect-ratio: 2 / 1; margin: 0 auto; line-height: 0; border-radius: 8px; overflow: hidden; }
  .hs-strip { position: absolute; top: 0; height: 100%; width: 200%;
    -webkit-mask-image: var(--hs-mask); mask-image: var(--hs-mask);
    -webkit-mask-size: 50% 100%; mask-size: 50% 100%; -webkit-mask-repeat: repeat-x; mask-repeat: repeat-x; }
  /* Markers and logo: the owner's two drawings as masks, painted with framework classes.
     hs-v--lava = heat detected; hs-v--erupt = GVP lists a continuing eruption.
     Geometry (1345x1306 canvas, anchor at 68.3% height) matches render/layout.py. */
  .hs-v { position: absolute; aspect-ratio: 1345 / 1306; transform: translate(-50%, -68.3%); z-index: 3; }
  .hs-v > i, .hs-logo > i { position: absolute; inset: 0; -webkit-mask-size: 100% 100%; mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; }
  .hs-v--lava > i { -webkit-mask-image: var(--hs-lava); mask-image: var(--hs-lava); }
  .hs-v--lava > i.hs-halo { -webkit-mask-image: var(--hs-lava-halo); mask-image: var(--hs-lava-halo); }
  .hs-v--erupt > i { -webkit-mask-image: var(--hs-erupt); mask-image: var(--hs-erupt); }
  .hs-v--erupt > i.hs-halo { -webkit-mask-image: var(--hs-erupt-halo); mask-image: var(--hs-erupt-halo); }
  .hs-logo { position: relative; display: inline-block; aspect-ratio: 1345 / 1306; flex: none; }
  .hs-l { position: absolute; white-space: nowrap; line-height: 1; z-index: 4; transform: translateY(-50%); }
  .hs-l--end { transform: translate(-100%, -50%); }
  .hs-l--middle { transform: translate(-50%, -50%); }
  .hs-lines { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; }
  .hs-lines line { vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .hs-lines .hs-lc { stroke: #fff; stroke-width: 3px; }
  .hs-lines .hs-ln { stroke: #000; stroke-width: 1px; }
</style>
{% template volcano_icon %}
<span class="hs-logo w--8 hs-v--erupt"><i class="hs-halo bg--white"></i><i class="bg--black"></i></span>
{% endtemplate %}
{% template volcano_world %}
{% render 'volcano_mapjs' %}
{% assign world_mask = '' %}
{% comment %} TRMNL X without the list: the framework map (sized like the close-ups) replaces our map. {% endcomment %}
<div id="hs-native" class="map stretch w--full rounded--base hidden{% unless show_list %} lg:block{% endunless %}">
  <span class="map__fallback title">Map unavailable on this screen</span>
</div>
{% if show_list %}{% if list_side %}{% assign hs_wv = "flex flex--row portrait:flex--col flex--top" %}{% else %}{% assign hs_wv = "flex flex--col flex--top" %}{% endif %}{% else %}{% assign hs_wv = "flex flex--col flex--center-y lg:hidden" %}{% endif %}
<div id="hs-wv" class="{{ hs_wv }} gap--small w--full h--full relative">
  <div id="hs-world" class="hs-map" data-map-slot="map-water">
    <div class="hs-strip" data-map-slot="map-land" style="left: -{{ view.shift }}%; --hs-mask: url(data:image/png;base64,{{ world_mask }});"></div>
    {% for m in view.markers %}
      {% assign w = m.w | times: map_scale %}
      <div class="hs-v hs-v--{{ m.k }}" style="left: {{ m.x }}%; top: {{ m.y }}%; width: {{ w }}%;">
        <i class="hs-halo bg--white"></i>
        <i class="{{ m.c }}"></i>
      </div>
    {% endfor %}
  </div>
  {% if show_list %}
  {% render 'volcano_list', markers: markers, list_cols: list_cols %}
  {% endif %}
</div>
<script type="text/javascript">
  // Paint the map-water / map-land slots exactly as the framework map does (dither on
  // 1-/2-bit, solids on 4-bit, theme and dark-mode aware). No map library involved.
  (function () {
    var tries = 0;
    (function attempt() {
      if (window.TRMNLPaint && window.TRMNLMaps) {
        return TRMNLPaint.watch("hs-world", function () { TRMNLMaps.applySwatches({ el: "hs-world" }); });
      }
      if (++tries <= 200) setTimeout(attempt, 50);
    })();
  })();

  // Labels on our own map are placed in the browser at the size this layout gives the map,
  // as on the framework map: text keeps its size while the map shrinks in smaller layouts.
  {% if show_labels %}
  HSMap.labelWorld("hs-world", {
    markers: {{ view.markers | json }}, maxLabels: {{ max_labels | json }}, mapScale: {{ map_scale | json }}
  });
  {% endif %}

  // TRMNL X (screen--lg) without the volcano list: the framework map fills the whole space
  // (CSS shows it in place of our map). Always started: it builds nothing while hidden and is
  // rebuilt whenever the screen's device/layout classes change (e.g. switching in the editor).
  HSMap.start("hs-native", {
    world: true, lon: {{ view.lon | json }}, markers: {{ markers | json }},
    showLabels: {{ show_labels | json }}, maxLabels: {{ max_labels | json }}, mapScale: {{ map_scale | json }}
  });
</script>
{% endtemplate %}
{% template volcano_mapjs %}
<script src="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.js"></script>
<link href="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.css" rel="stylesheet">
<script type="text/javascript">
  // The TRMNL framework map (outline preset, as-is) with our markers and labels on top.
  // HSMap.start(el, { bbox | world + lon, markers, showLabels, maxLabels, mapScale })
  window.HSMap = window.HSMap || (function () {
    function whenReady(cb) {
      var tries = 0;
      (function attempt() {
        if (window.TRMNLMaps && window.maplibregl) return cb();
        if (++tries > 200) return;
        setTimeout(attempt, 50);
      })();
    }

    function overlaps(a, b) { return a[0] < b[2] && b[0] < a[2] && a[1] < b[3] && b[1] < a[3]; }

    // Markers are our own markup over the map: icon size and shade come from the payload.
    function place(map, el, o) {
      var box = document.getElementById(el), markers = o.markers, mapScale = o.mapScale;
      Array.prototype.forEach.call(box.querySelectorAll(".hs-v, .hs-l, .hs-lines"), function (n) { n.remove(); });
      var W = box.clientWidth, H = box.clientHeight, c = map.getCenter().lng, shown = [];
      markers.forEach(function (m) {
        var lon = c + ((m.lon - c + 540) % 360) - 180;  // nearest world copy
        var pt = map.project([lon, m.lat]);
        if (pt.x < 0 || pt.x > W || pt.y < 0 || pt.y > H) return;
        var d = m.w * mapScale * W / 100;
        var v = document.createElement("div");
        v.className = "hs-v hs-v--" + m.k;
        v.style.left = Math.round(pt.x) + "px";
        v.style.top = Math.round(pt.y) + "px";
        v.style.width = Math.round(d) + "px";
        v.innerHTML = '<i class="hs-halo bg--white"></i><i class="' + m.c + '"></i>';
        box.appendChild(v);
        // Visible icon box (canvas 1345x1306, anchor at 68.3% height; see render/layout.py).
        var h = d * 1306 / 1345, top = pt.y - 0.683 * h, left = pt.x - d / 2, b = ICON_BOX[m.k];
        shown.push({ m: m, v: v, x: pt.x, y: pt.y, box: [left + b[0] * d, top + b[1] * h, left + b[2] * d, top + b[3] * h] });
      });
      if (o.showLabels) placeLabels(box, W, H, shown, o.maxLabels);
    }

    // Labels with leader lines (in px, measured on the page):
    // next to the icon if free, else out along one of sixteen directions with a line back
    // to the icon (never through a label or an icon not stacked on its own), else dropped.
    // Newest first.
    var ANGLES = [0, 180, -45, -135, 45, 135, -90, 90, -22.5, -157.5, 22.5, 157.5, -67.5, -112.5, 67.5, 112.5];
    var ICON_BOX = { lava: [0.052, 0.420, 0.948, 0.946], erupt: [0.052, 0.054, 0.948, 0.946] };
    function inside(px, py, b) { return b[0] < px && px < b[2] && b[1] < py && py < b[3]; }
    function lineHits(ln, bs, step) {
      var n = Math.max(2, Math.ceil(Math.hypot(ln[2] - ln[0], ln[3] - ln[1]) / step));
      for (var k = 1; k < n; k++) {
        var t = k / n, px = ln[0] + (ln[2] - ln[0]) * t, py = ln[1] + (ln[3] - ln[1]) * t;
        for (var j = 0; j < bs.length; j++) if (inside(px, py, bs[j])) return true;
      }
      return false;
    }
    function placeLabels(box, W, H, shown, maxLabels) {
      var boxes = shown.map(function (s) { return s.box; });
      var nIcons = boxes.length, lines = [], g = 3, sample = 0.0025 * W;
      var steps = [0.015, 0.025, 0.035, 0.05, 0.065, 0.08, 0.10].map(function (f) { return f * W; });
      var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      svg.setAttribute("class", "hs-lines");
      svg.setAttribute("viewBox", "0 0 " + W + " " + H);
      box.appendChild(svg);
      shown.map(function (s, i) { return i; })
        .sort(function (a, b) { return shown[a].m.a - shown[b].m.a || shown[b].m.w - shown[a].m.w; })
        .slice(0, maxLabels)
        .forEach(function (i) {
          var s = shown[i], x = s.x, y = s.y, ib = s.box;
          var span = document.createElement("span");
          span.className = "hs-l label label--small text-stroke";
          span.textContent = s.m.n;
          box.appendChild(span);
          // Small margin: the framework's text pass can still nudge glyph widths after measuring.
          var tw = Math.ceil(span.offsetWidth * 1.08) + 2, th = span.offsetHeight + 2;
          var near = [ib[0] - g, ib[1] - g, ib[2] + g, ib[3] + g];
          var blockers = boxes.filter(function (b, j) { return j !== i && (j >= nIcons || !overlaps(b, near)); });
          function fits(b) {
            return b[0] >= 0 && b[1] >= 0 && b[2] <= W && b[3] <= H &&
              !boxes.some(function (o) { return overlaps(b, o); }) &&
              !lines.some(function (ln) { return lineHits(ln, [b], sample); });
          }
          function rectFor(anchor, ex, ey, vertical) {
            if (anchor === "start") return [ex, ey - th / 2, ex + tw, ey + th / 2];
            if (anchor === "end") return [ex - tw, ey - th / 2, ex, ey + th / 2];
            return vertical < 0 ? [ex - tw / 2, ey - th, ex + tw / 2, ey] : [ex - tw / 2, ey, ex + tw / 2, ey + th];
          }
          var pick = null;
          [["start", ib[2] + g, y, 0], ["end", ib[0] - g, y, 0], ["middle", x, ib[1] - g, -1], ["middle", x, ib[3] + g, 1]]
            .some(function (o) {
              var r = rectFor(o[0], o[1], o[2], o[3]);
              if (fits(r)) { pick = { a: o[0], r: r, ln: null }; return true; }
              return false;
            });
          for (var si = 0; !pick && si < steps.length; si++) {
            for (var ai = 0; !pick && ai < ANGLES.length; ai++) {
              var rad = ANGLES[ai] * Math.PI / 180, dx = Math.cos(rad), dy = Math.sin(rad);
              var tx = Math.abs(dx) > 1e-9 ? ((dx > 0 ? ib[2] : ib[0]) - x) / dx : Infinity;
              var ty = Math.abs(dy) > 1e-9 ? ((dy > 0 ? ib[3] : ib[1]) - y) / dy : Infinity;
              var r0 = Math.max(0, Math.min(tx, ty));
              var ex = x + dx * (r0 + steps[si]), ey = y + dy * (r0 + steps[si]);
              var a = dx > 0.3 ? "start" : dx < -0.3 ? "end" : "middle";
              var r = rectFor(a, ex, ey, dy);
              var ln = [x + dx * r0, y + dy * r0, ex, ey];
              if (fits(r) && !lineHits(ln, blockers, sample)) pick = { a: a, r: r, ln: ln };
            }
          }
          if (!pick) { span.remove(); return; }
          boxes.push(pick.r);
          span.classList.add("hs-l--" + pick.a);
          span.style.left = Math.round(pick.a === "start" ? pick.r[0] : pick.a === "end" ? pick.r[2] : (pick.r[0] + pick.r[2]) / 2) + "px";
          span.style.top = Math.round((pick.r[1] + pick.r[3]) / 2) + "px";
          if (pick.ln) {
            lines.push(pick.ln);
            ["hs-lc", "hs-ln"].forEach(function (cls) {
              var l = document.createElementNS("http://www.w3.org/2000/svg", "line");
              l.setAttribute("class", cls);
              l.setAttribute("x1", pick.ln[0]); l.setAttribute("y1", pick.ln[1]);
              l.setAttribute("x2", pick.ln[2]); l.setAttribute("y2", pick.ln[3]);
              svg.appendChild(l);
            });
          }
        });
    }

    // Our own world map: markers are already placed (percent of the box); label them with
    // the same rules once the framework's pass and fonts are done, so widths are final.
    function labelWorld(el, o) {
      function run() {
        var box = document.getElementById(el), W = box.clientWidth, H = box.clientHeight;
        Array.prototype.forEach.call(box.querySelectorAll(".hs-l, .hs-lines"), function (n) { n.remove(); });
        if (!W || !H) return;  // hidden on this screen (TRMNL X shows the framework map)
        var shown = o.markers.map(function (m) {
          var x = m.x * W / 100, y = m.y * H / 100, d = m.w * o.mapScale * W / 100, h = d * 1306 / 1345;
          var top = y - 0.683 * h, left = x - d / 2, b = ICON_BOX[m.k];
          return { m: m, x: x, y: y, box: [left + b[0] * d, top + b[1] * h, left + b[2] * d, top + b[3] * h] };
        });
        placeLabels(box, W, H, shown, o.maxLabels);
      }
      var tries = 0;
      (function wait() {
        if (!window.TRMNL_PLUGINS_READY && ++tries <= 100) return setTimeout(wait, 50);
        // Again whenever the screen's classes change: the editor switches device and layout in place.
        var watchRun = function () { if (window.TRMNLPaint) TRMNLPaint.watch(el, run); else run(); };
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(watchRun); else watchRun();
      })();
    }

    function start(el, o) {
      whenReady(function () {
        TRMNLMaps.watch(el, function () {
          var bbox = o.bbox, center = o.center, zoom = o.zoom;
          if (o.world) {
            // Hidden here (not TRMNL X, or the volcano list is on): no map now; watch() builds
            // it again when the screen's classes change.
            var box = document.getElementById(el), W = box.clientWidth, H = box.clientHeight;
            if (!W || !H) return null;
            // Whole world at a whole zoom, centred on the view's meridian and, north–south, on
            // 55°S–65°N where nearly all active volcanoes are. Across, the world may be up to
            // 10% narrower than the box (the edges repeat a sliver of it) rather than jumping
            // a zoom and showing half: on TRMNL X the box is a few px over zoom 1's 1024 px.
            // Down, it must cover the box (no band beyond the poles). Narrow boxes crop
            // longitudes.
            var zW = Math.floor(Math.log2(W / 512) + 0.15), zH = Math.ceil(Math.log2(H / 512) - 1e-9);
            zoom = Math.max(0, zW, zH);
            var my = function (lat) { return Math.log(Math.tan(Math.PI / 4 + lat * Math.PI / 360)); };
            var half = H / (512 * Math.pow(2, zoom)) * Math.PI;
            var y = Math.max(-Math.PI + half, Math.min(Math.PI - half, (my(65) + my(-55)) / 2));
            center = [o.lon, (2 * Math.atan(Math.exp(y)) - Math.PI / 2) * 180 / Math.PI];
          }
          // Outline preset without the map's own place names: they collided with our volcano
          // labels and some scripts draw as empty boxes. Only volcano names are drawn.
          var opts = TRMNLMaps.options({
            el: el, preset: "outline", tiles: "trmnl", labels: false,
            center: center || [(bbox[0] + bbox[2]) / 2, (bbox[1] + bbox[3]) / 2], zoom: bbox ? 3 : zoom
          });
          opts.renderWorldCopies = true;
          var map = new maplibregl.Map(opts);
          if (bbox) {
            // Zoom stays on whole numbers so dither lands on the pixel grid. Round up when the
            // exact fit is within 0.3 of the next zoom (crops the box by at most ~20%), otherwise
            // round down (shows a little more than the box).
            var cam = map.cameraForBounds([[bbox[0], bbox[1]], [bbox[2], bbox[3]]], { padding: 0 });
            if (cam) map.jumpTo({ center: cam.center, zoom: Math.min(6, Math.floor(cam.zoom + 0.3)) });
          }
          map.on("load", function () { place(map, el, o); });
          return map;
        });
      });
    }
    return { start: start, labelWorld: labelWorld };
  })();
</script>
{% endtemplate %}
{% template volcano_list %}
{% comment %} Volcano list setting: framework items, newest first (only names, if given: a close-up's region).
   The framework's overflow engine drops rows that don't fit and adds "and N more". Columns per screen
   size come from the layout as list_cols "md,md-portrait,lg,lg-portrait" (TRMNL OG, OG portrait, X,
   X portrait), sized to the space the list gets in that layout and rows ~250 px wide. {% endcomment %}
<div id="hs-list" class="hs-list {{ list_class | default: "grow basis--0 w--full h--full" }}">
  {% assign list_n = list_cols | default: "1,1,1,1" | split: "," %}
  <div class="columns" data-overflow-max-cols="1" data-overflow-max-cols-md="{{ list_n[0] }}" data-overflow-max-cols-md-portrait="{{ list_n[1] }}" data-overflow-max-cols-lg="{{ list_n[2] }}" data-overflow-max-cols-lg-portrait="{{ list_n[3] }}" data-overflow-counter="true">
    <div class="column">
    {% if names and names.size == 0 %}<span class="description">No recent heat at volcanoes in this region.</span>{% endif %}
    {% assign hs_now = "now" | date: "%s" | plus: 0 %}
    {% assign by_age = markers | sort: "a" %}
    {% for m in by_age %}
      {% if names == nil or names contains m.n %}
      {% assign age_h = hs_now | minus: m.s | divided_by: 3600 %}
      <div class="item">
        <div class="icon"><span class="hs-logo w--9 hs-v--{{ m.k }}"><i class="hs-halo bg--white"></i><i class="{{ m.c }}"></i></span></div>
        <div class="content">
          <span class="title title--small">{{ m.n }}</span>
          <div class="flex flex--nowrap gap--small">
            {% if m.k == "erupt" %}<span class="label label--small label--filled no-shrink">erupting</span>{% else %}<span class="label label--small label--outline no-shrink">heat only</span>{% endif %}
            <span class="label label--small label--underline no-shrink">{% if age_h < 1 %}&lt;1 h{% elsif age_h < 48 %}{{ age_h }} h{% else %}{{ age_h | divided_by: 24 }} d{% endif %} ago</span>
            {% if m.co != "" %}<span class="description">{{ m.co }}</span>{% endif %}
          </div>
        </div>
      </div>
      {% endif %}
    {% endfor %}
    </div>
  </div>
</div>
<script type="text/javascript">
  // When not even one row fits (e.g. the original TRMNL in full screen with the title bar), hide the
  // framework's lone "and N more" too. Checked after its overflow pass and again on screen changes.
  (function () {
    var tries = 0;
    function check() {
      var list = document.getElementById("hs-list");
      if (!list) return;
      var shown = Array.prototype.some.call(list.querySelectorAll(".item"), function (i) {
        return i.querySelector(".content") && window.getComputedStyle(i).display !== "none";
      });
      list.style.visibility = shown || {{ names.size | default: 1 }} === 0 ? "" : "hidden";
    }
    (function wait() {
      if (!window.TRMNL_PLUGINS_READY && ++tries <= 100) return setTimeout(wait, 50);
      setTimeout(check, 0);
      var list = document.getElementById("hs-list");
      if (list && window.TRMNLPaint) TRMNLPaint.watch(list, function () { setTimeout(check, 100); }, { immediate: false });
    })();
  })();
</script>
{% endtemplate %}
{% template volcano_closeup %}
{% render 'volcano_mapjs' %}
{% comment %} With the volcano list, the map and the list of the region's volcanoes share the space. In wide
   layouts (full screen, half-horizontal) the list is a one-column strip beside the map, so the region keeps
   most of the room and its zoom; in portrait, and in narrow layouts, the list goes below the map. {% endcomment %}
{% if show_list %}
{% if list_side or closeup_side %}
  {% assign hs_c = list_cols | default: "1,1,1,1" | split: "," %}
  {% assign hs_cols = "1," | append: hs_c[1] | append: ",1," | append: hs_c[3] %}
  {% assign hs_cw = "flex flex--row portrait:flex--col" %}
  {% assign hs_lc = "no-shrink w--72 h--full portrait:grow portrait:basis--0 portrait:w--full" %}
{% else %}
  {% assign hs_cols = list_cols %}
  {% assign hs_cw = "flex flex--col" %}
  {% assign hs_lc = nil %}
{% endif %}
<div class="{{ hs_cw }} flex--top gap--small w--full h--full">
  <div id="hs-closeup" class="map grow basis--0 w--full h--full rounded--base">
    <span class="map__fallback title">Map unavailable on this screen</span>
  </div>
  {% render 'volcano_list', markers: markers, names: view.names, list_cols: hs_cols, list_class: hs_lc %}
</div>
{% else %}
<div id="hs-closeup" class="map stretch w--full rounded--base">
  <span class="map__fallback title">Map unavailable on this screen</span>
</div>
